#!/usr/bin/env bash
# Pre-push hook: verify the pushed tree before it reaches the remote.
# Mirrors protocol.config.yaml and fails closed.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

run_gate() {
  local label="$1"
  shift

  echo "pre-push: $label"
  "$@"
  local status=$?

  if [ "$status" -ne 0 ]; then
    echo "pre-push: $label failed with exit $status — push refused" >&2
    exit "$status"
  fi
}

if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
  run_gate "attribution guard" node scripts/attribution-guard.mjs --range origin/main..HEAD
else
  run_gate "attribution guard" node scripts/attribution-guard.mjs --all
fi
run_gate "attribution documents" node scripts/attribution-document-guard.mjs
# `verify` owns the ordered gate contract. The hook does not restate it, so a
# gate added there cannot be silently omitted here. A disposable
# TEST_DATABASE_URL is reused for the HTTP suites by scripts/verify.mjs; an
# explicit HTTP_TEST_DATABASE_URL still wins.
run_gate "verify" npm run verify

echo "pre-push: all gates passed"
