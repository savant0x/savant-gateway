{
	"name": "savant-gateway",
	"version": "0.1.0",
	"description": "An independent inference gateway: one OpenAI-compatible endpoint over multiple upstream providers, with prepaid credit, account-owned keys and an operator console.",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"check": "npm run lint && npm run typecheck",
		"config:check": "node scripts/production-config-check.mjs",
		"config:check:prod": "node scripts/production-config-check.mjs --production",
		"test": "node --test \"tests/*.test.mjs\"",
		"test:http": "node scripts/http-suite.mjs && node scripts/trial-http-suite.mjs",
		"test:postgres": "node scripts/postgres-concurrency-proof.mjs",
		"test:recovery": "node scripts/db-recovery-drill.mjs",
		"test:load": "node scripts/load-acceptance.mjs",
		"test:load:accept": "node scripts/load-acceptance.mjs --require-approval",
		"db:backup": "node scripts/db-backup.mjs",
		"db:restore": "node scripts/db-restore.mjs",
		"db:import": "node scripts/sqlite-import.mjs",
		"seed:content": "node scripts/seed-content-sources.mjs",
		"operations:monitor": "node scripts/operations-monitor.mjs",
		"probe:speed": "node --env-file=.env.local scripts/upstream-speed-probe.mjs",
		"images": "node scripts/render-images.mjs",
		"quality": "node scripts/quality-report.mjs",
		"attribution": "node scripts/attribution-guard.mjs --all && node scripts/attribution-document-guard.mjs",
		"storage:check": "node scripts/storage-contract-check.mjs",
		"business-model": "node scripts/business-model.mjs",
		"receipt:deploy": "node scripts/deployment-receipt.mjs --json",
		"receipt:launch": "node scripts/launch-receipt.mjs",
		"verify": "node scripts/verify.mjs",
		"prepare": "node scripts/prepare.mjs"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^6.7.2",
		"@heroui/react": "3.2.7",
		"@heroui/styles": "3.2.7",
		"@noble/curves": "2.4.0",
		"@noble/hashes": "2.4.0",
		"@scure/bip32": "2.4.0",
		"@vercel/speed-insights": "^2.0.0",
		"clsx": "2.1.1",
		"fast-xml-parser": "^5.11.2",
		"intl-messageformat": "10.7.18",
		"next": "16.4.3",
		"next-themes": "0.4.6",
		"pg": "^8.23.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"sanitize-html": "^2.18.1",
		"server-only": "0.0.1",
		"stripe": "23.0.1"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.14",
		"@eslint/compat": "1.4.1",
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "9.39.5",
		"@next/eslint-plugin-next": "16.4.3",
		"@tailwindcss/postcss": "4.3.3",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "20.19.43",
		"@types/pg": "^8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/sanitize-html": "^2.16.2",
		"@typescript-eslint/eslint-plugin": "8.70.1",
		"@typescript-eslint/parser": "8.70.1",
		"better-sqlite3": "13.0.3",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.3",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-node": "11.1.0",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "5.2.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "16.5.0",
		"pglite-server": "^0.1.5",
		"postcss": "8.5.28",
		"prettier": "3.9.9",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3"
	}
}
