# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (Vercel-pulled production env is local-only as well)
.env
.env*.local
.env.vercel*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

pnpm-lock.yaml
yarn.lock
bun.lockb
# local database, cookies, and runtime logs
/data/
/database.db
/database.db-shm
/database.db-wal
/.m.log
/firebase-debug.log
/.cloud-attachments/

# Reference-only copies of other projects. Read them, never import from them and
# never commit them; they carry their own dependencies, lockfiles and configs.
/resources/

# local agent/runtime state
.freebuff/
/.commandcode/
/.opencode/
/.savant/
/debug/
/dev/audit/
dev/exports/
dev/scratchpad/

# local audit baselines for FID-2026-1029-001 (kept on disk, not published)
dev/fids/audit/

# temporary design exports
.superdesign/tmp/

# Billing documents — invoices, credit notes and receipts — are kept outside this
# working tree. Nothing in this repository needs a PDF, so the whole extension is
# ignored rather than trusting a filename pattern to catch every provider's
# format. A deliberately published PDF needs `git add -f` and a reason in the FID.
*.pdf
