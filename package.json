{
	"name": "savant-gateway",
	"version": "0.1.0",
	"description": "An independent inference gateway: one OpenAI-compatible endpoint over multiple upstream providers, with prepaid credit, account-owned keys and an operator console.",
	"type": "module",
	"private": true,
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"check": "npm run lint && npm run typecheck",
		"config:check": "node scripts/production-config-check.mjs",
		"test": "node --test \"tests/*.test.mjs\"",
		"test:http": "node scripts/http-suite.mjs && node scripts/trial-http-suite.mjs",
		"images": "node scripts/render-images.mjs",
		"quality": "node scripts/quality-report.mjs",
		"business-model": "node scripts/business-model.mjs",
		"verify": "npm run check && npm run config:check && npm run test && npm run quality && npm run build && npm run test:http",
		"prepare": "git config core.hooksPath .githooks && git config commit.template .gitmessage"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^6.7.2",
		"@heroui/react": "3.2.7",
		"@heroui/styles": "3.2.7",
		"better-sqlite3": "13.0.3",
		"clsx": "2.1.1",
		"intl-messageformat": "10.7.18",
		"next": "16.4.3",
		"next-themes": "0.4.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"server-only": "0.0.1",
		"stripe": "23.0.1"
	},
	"devDependencies": {
		"@eslint/compat": "1.4.1",
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "9.39.5",
		"@next/eslint-plugin-next": "16.4.3",
		"@tailwindcss/postcss": "4.3.3",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "20.19.43",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/eslint-plugin": "8.70.1",
		"@typescript-eslint/parser": "8.70.1",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.3",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-node": "11.1.0",
		"eslint-plugin-prettier": "5.5.6",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "5.2.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "16.5.0",
		"postcss": "8.5.28",
		"prettier": "3.9.9",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3"
	}
}
