# Upstream provider keys. Server-only. Never expose these to the browser.
# Admin → Providers stores the variable name; these variables hold the values.
# Default provider (Savant).
PROVIDER_KEY=
# Optional second provider (CommandCode). Blank keeps it unconfigured.
COMMANDCODE_API_KEY=
# Optional third provider (Apixo). Provider row ships disabled; enable it in
# Admin → Providers after this key is set and the catalog has synced.
# Rows seeded before this name was aligned used APIXO_API_KEY; the schema
# migration renames that untouched value automatically.
APIXOAI_API_KEY=

# Admin panel. Both values are required to enable /admin.
# ADMIN_PASSWORD must be 12+ characters; ADMIN_SESSION_SECRET 32+.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Public site origin used for Stripe redirects and customer links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Production requires a networked postgres:// or postgresql:// URL;
# the server refuses to start without one. Local development may leave this
# blank and use the embedded PGlite engine below.
# Use the provider's pooled connection string on serverless hosts.
DATABASE_URL=

# Local PGlite directory used only when DATABASE_URL is blank. Default data/pg.
PG_LOCAL_PATH=

# Mechanical HTTP/load suites only. Never set this on a real deployment; the
# readiness route reports mode: "disposable" when it is set.
GATEWAY_DISPOSABLE_START=

# Customer credit top-ups and subscription plans. Server-only. Stripe Checkout
# handles card data. The webhook must receive invoice and subscription events.
# Webhook signing secret from `stripe listen` or the Stripe dashboard.
# Local forwarding: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Declared payment environment: true for live keys, false for test keys.
# When set, a delivery whose livemode disagrees is quarantined without credit.
STRIPE_EXPECTED_LIVEMODE=

# Card top-ups. OFF for a crypto-only launch. Stripe credentials alone do not
# enable card sales; set CARD_TOPUPS_ENABLED=true only after the operator
# approves cards again. The webhook stays active so an in-flight session still
# credits correctly while the lane is closed.
CARD_TOPUPS_ENABLED=false

# Crypto top-ups through NOWPayments. OFF by default and independent of the API
# key and IPN secret: credentials alone never enable sales; set
# NOWPAYMENTS_TOPUPS_ENABLED=true only after the operator approves the lane.
# NOWPAYMENTS_SANDBOX=true targets api-sandbox.nowpayments.io so a key pair can
# never silently hit the wrong environment.
NOWPAYMENTS_TOPUPS_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# Promo codes. OFF by default and independent of the payment lanes: issued codes
# stay in the database, but a customer cannot redeem one until this is true.
# A redemption grants prepaid dollar credit once and is recorded in the same
# credit ledger as a Stripe top-up. The existing weighted-token free pool is a
# separate allowance and is not changed by this flag.
PROMO_CODES_ENABLED=false

# Optional upstream endpoints. PROVIDER_BASE_URL seeds the default provider's
# base URL on first boot; change it later in Admin → Providers.
PROVIDER_BASE_URL=https://api.apinex.bond/v1
PROVIDER_PUBLIC_MODELS_URL=https://apinex.bond/api/public/models
# Automatic provider sync. A catalog read refreshes any enabled, configured
# provider whose last sync is older than this interval; 0 disables it.
PROVIDER_SYNC_INTERVAL_HOURS=6
# A row priced from a manually entered upstream cost is withheld from the public
# catalog once that cost is older than this many days. 0 keeps it published.
# The cron-managed providers publish machine-readable prices, so this guard is
# aimed at manual-cost upstreams like Apixo that publish none.
PROVIDER_PRICE_MAX_AGE_DAYS=30
# Public price benchmark for /models. Optional; a failure renders the catalog
# without comparisons instead of breaking the page.
OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models

# Model benchmarks (quality, output speed, time to first token). Server-only.
# Blank keeps the quality column off the catalog; nothing else changes. The free
# tier allows 100 requests per 24h window and a full sync costs two today, so
# catalog reads stored rows and refreshes out of band.
ARTIFICIAL_ANALYSIS_API_KEY=
ARTIFICIAL_ANALYSIS_BASE_URL=https://artificialanalysis.ai/api/v2
# Staleness threshold for a read-path refresh, and the floor between runs.
AA_REFRESH_HOURS=24
AA_MIN_SYNC_INTERVAL_HOURS=6

# Free-pool admission control. The upstream free plan allows a fixed weighted
# pool per UTC day; the gateway splits a share of it evenly across activated
# accounts (an account with at least one active key). 9000 bps = 90% allocated,
# 10% held back. FREE_DAILY_WEIGHTED_TOKENS is the per-user fallback allowance
# used only when shared allocation is disabled.
# Completion rate limits. Free traffic shares one bucket for every key and must
# stay under the upstream account ceiling; paid keys share their account bucket.
FREE_SHARED_RPM=12
PAID_KEY_RPM=60
# Trust only a single IP header stripped and set by the controlled ingress.
# Supported: fly-client-ip or x-real-ip. Blank ignores all client IP headers and
# uses one shared client bucket. Never expose a direct route around the proxy.
GATEWAY_TRUSTED_IP_HEADER=
# Optional account email. Explicit opt-in; unset keeps verification/recovery off.
# Configure a verified sender in the selected service before enabling delivery.
EMAIL_TRANSPORT=
EMAIL_FROM=
RESEND_API_KEY=
# Provider-wide admission: one ceiling per serving upstream account, shared by
# free, trial, subscription and credit traffic. A current upstream rpm wins;
# PROVIDER_SHARED_RPM is the explicit fallback when the account publishes none.
# Unknown capacity refuses before dispatch instead of assuming headroom.
PROVIDER_SHARED_RPM=15
PROVIDER_SHARED_CONCURRENCY=4
FREE_POOL_DAILY_WEIGHTED_TOKENS=20000000
FREE_POOL_ALLOCATION_BPS=9000
FREE_POOL_ALLOCATION_ENABLED=true
# Weighted tokens one account may spend per UTC day. 0 disables the cap and
# leaves the even split as the only limit.
FREE_ACCOUNT_DAILY_CAP=100000
FREE_DAILY_WEIGHTED_TOKENS=500000
FREE_PROVIDER_REMAINING_FLOOR=1000000
FREE_PROVIDER_ALERT_THRESHOLD=2000000

# Lifetime trial conversion. OFF until launch gates pass. Verified accounts only.
# Grant budget is gateway-wide lifetime issuance capacity; zero issues no grants.
TRIAL_ENABLED=false
TRIAL_WEIGHTED_TOKENS=100000
TRIAL_GATEWAY_GRANT_BUDGET=0
# Explicit public trial id -> paid public id; no inferred substitutions.
TRIAL_MODEL_PAIRS={}

# Plan sales. OFF by default and independent of STRIPE_SECRET_KEY: unset or any
# value other than true/1/yes/on keeps plans out of the public catalog, refuses
# new checkouts and blocks publishing a plan. Existing subscriptions, comps,
# invoices and the customer portal keep working while sales are off.
PLAN_SALES_ENABLED=false

# Operations monitor. The monitor is scheduled externally (cron/Fly scheduled
# machine); it does not run an in-process timer. With no webhook URL, incidents
# are durable and visible in /admin/operations, and nothing leaves the process.
# The URL must be https outside a disposable loopback runtime. When the secret
# is set (16+ characters), the raw body is signed as
# x-savant-signature: sha256=<hex>.
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_SECRET=
OPERATIONS_ALERT_TIMEOUT_MS=5000
OPERATIONS_ALERT_MAX_ATTEMPTS=3
OPERATIONS_ALERT_RETRY_SECONDS=60
# Rule thresholds. Malformed values fall back to these defaults, never to off.
OPERATIONS_WINDOW_MINUTES=60
OPERATIONS_MIN_REQUESTS=20
OPERATIONS_ERROR_RATE_BPS=1000
OPERATIONS_SETTLEMENT_MAX_AGE_SECONDS=900
OPERATIONS_PAYMENT_MAX_AGE_SECONDS=1800
OPERATIONS_QUOTA_MAX_AGE_SECONDS=120
# 0 disables the low-reserve, database-size and backup-age rules.
OPERATIONS_RESERVE_MIN_TOKENS=0
OPERATIONS_DATABASE_MAX_BYTES=0
OPERATIONS_BACKUP_MAX_AGE_SECONDS=0

# Content surface (Signal). Enabled unless explicitly set to false. Ingestion
# is operator-triggered from Admin → Content or by the cron route below; the
# ingest switch gates scheduled work only, not an explicit admin fetch.
CONTENT_ENABLED=true
CONTENT_INGEST_ENABLED=false
CONTENT_CRON_SECRET=
# YouTube Data API key. Optional: a UC… channel id works without it, a @handle
# resolves from the public channel page, and likes plus YouTube comment counts
# need the key for enrichment. Views and the star rating come from the channel
# feed either way.
YOUTUBE_API_KEY=
# Optional GitHub token for repository facts and READMEs (stars, forks,
# language, topics, README). Without it, public unauthenticated requests still
# work at a lower rate limit; a read-only public-repo token raises it.
GITHUB_TOKEN=

# Backups default to <database provider or local data>/backups; the operations
# snapshot and the backup/restore scripts share BACKUP_DIR when it is set.
BACKUP_DIR=
